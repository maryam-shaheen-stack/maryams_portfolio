# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API
# (your local Vite dev server + your deployed frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth ---
# Any long random string (e.g. run `openssl rand -hex 32` to generate one)
JWT_SECRET=

# Used once by `npm run seed:admin` to create your admin login.
# Change ADMIN_PASSWORD and re-run that script any time to reset it.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# --- File uploads (Cloudinary) ---
# Create a free account at https://cloudinary.com, then grab these three
# values from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
